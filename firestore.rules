rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidMesKey(key) {
      return key is string && key.size() >= 7 && key.size() <= 10 && key.matches('^[0-9]{4}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data, userId) {
      return data.id is string && data.id == userId &&
             data.email is string && data.email.size() <= 120 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.accountType in ['individual', 'pareja'] &&
             data.currency is string && data.currency.size() <= 10 &&
             (!('lastName' in data) || (data.lastName is string && data.lastName.size() <= 100)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30));
    }

    function isValidBudget(data, userId) {
      return data.userId is string && data.userId == userId;
    }

    function isValidMonthlyMovement(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.mesKey is string && isValidMesKey(data.mesKey);
    }

    function isValidMovementItem(data, userId) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId == userId &&
             data.concepto is string && data.concepto.size() > 0 && data.concepto.size() <= 200 &&
             data.monto is number && data.monto >= 0 &&
             data.categoria is string && data.categoria.size() <= 100 &&
             data.fecha is string && data.fecha.size() == 10;
    }

    // Collection: Users
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create, update: if isValidId(userId) && isOwner(userId) && isValidUser(incoming(), userId);
      allow delete: if false;

      // Subcollection: Presupuestos
      match /presupuestos/{budgetId} {
        allow get, list: if isValidId(userId) && isOwner(userId);
        allow create, update: if isValidId(userId) && isValidId(budgetId) && isOwner(userId) && isValidBudget(incoming(), userId);
        allow delete: if isValidId(userId) && isValidId(budgetId) && isOwner(userId);
      }

      // Subcollection: Movimientos particionados por mes (evita descargar el histórico entero)
      match /movimientos/{mesKey} {
        allow get, list: if isValidId(userId) && isValidMesKey(mesKey) && isOwner(userId);
        allow create, update: if isValidId(userId) && isValidMesKey(mesKey) && isOwner(userId) && isValidMonthlyMovement(incoming(), userId);
        allow delete: if isValidId(userId) && isValidMesKey(mesKey) && isOwner(userId);

        // Movimientos individuales del mes
        match /items/{movimientoId} {
          allow get, list: if isValidId(userId) && isValidMesKey(mesKey) && isOwner(userId);
          allow create, update: if isValidId(userId) && isValidMesKey(mesKey) && isValidId(movimientoId) && isOwner(userId) && isValidMovementItem(incoming(), userId);
          allow delete: if isValidId(userId) && isValidMesKey(mesKey) && isValidId(movimientoId) && isOwner(userId);
        }
      }
    }
  }
}
